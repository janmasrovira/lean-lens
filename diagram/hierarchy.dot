digraph LeanLensHierarchy {
  rankdir=TB;
  node [shape=box, fontname="monospace", style=rounded];
  edge [fontname="monospace", fontsize=10];

  LensLike      [label=<LensLike f s t a b<BR/>(a → f b) → s → f t<BR/>f : Type → Type>];
  Lens          [label=<Lens s t a b<BR/>∀ f [Functor f]>];
  Traversal     [label=<Traversal s t a b<BR/>∀ f [Applicative f]>];
  SimpleGetter  [label=<SimpleGetter s a<BR/>f = Const r>];
  ASetter       [label=<ASetter s t a b<BR/>f = Id>];
  Getting       [label=<Getting r s a<BR/>f = Const r <FONT FACE="Helvetica-Oblique" POINT-SIZE="10">r fixed</FONT>>];
  SimpleFold    [label=<SimpleFold s a<BR/>f = Const r [Monoid r]>];

  LensLike -> Lens;
  LensLike -> Traversal;

  Lens -> SimpleGetter;
  Lens -> ASetter;

  Traversal -> ASetter;
  Traversal -> SimpleFold;

  SimpleGetter -> Getting;
  SimpleGetter -> SimpleFold;

  { rank=same; ASetter; SimpleGetter; }
  { rank=same; Getting; SimpleFold; }

  label="\nlean-lens optic hierarchy\nedge A → B reads: \"an A can be used as a B\" (by specializing the functor f)";
  labelloc="b";
  fontname="monospace";
}
